# LabeloxAV environment for LOCAL DEVELOPMENT: infrastructure in Docker, code on the host (`make up`).
# Copy to .env and adjust. The credentials below are deliberately weak and well-known.
#
# DO NOT use this file to deploy. core/config.py refuses these exact defaults on anything that is not an
# explicit local dev box and will not boot, because a known signing key lets anyone mint an admin token.
# To run the whole product, use the installer, which generates strong secrets and writes its own .env:
#
#     ./scripts/install.sh
#
# See docs/DEPLOY.md. The variables the installer additionally sets are listed at the bottom of this file.

# Postgres (system of record + PostGIS)
POSTGRES_USER=labelox
POSTGRES_PASSWORD=labelox
POSTGRES_DB=labeloxav
POSTGRES_PORT=5432

# MinIO (S3-compatible object store)
MINIO_ROOT_USER=labelox
MINIO_ROOT_PASSWORD=labelox123
MINIO_BUCKET=labeloxav
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Redis (job state, triage cache, locks)
REDIS_PORT=6379

# Redpanda (Kafka-API event bus)
REDPANDA_PORT=19092
REDPANDA_ADMIN_PORT=9644

# App-side overrides (LBX_ prefix, double underscore for nesting).
# Defaults in configs/default.yaml already target localhost-exposed compose ports.
# Example override:
# LBX_GPU__MODE=sequential
# LBX_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------------
# Deployment only. `scripts/install.sh` generates all of these with `openssl rand`;
# they are listed here so the set is documented rather than discovered by a failed boot.
# Each is refused by core/config.py if left at its built-in default off a local box.
#
# LBX_ENV=production                    # turns on the secret checks and requires auth
# WEB_PORT=3000                         # what a person opens
# API_PORT=8000
# POSTGRES_PASSWORD=<generated>
# MINIO_ROOT_USER=<generated>           # the object-store access key
# MINIO_ROOT_PASSWORD=<generated>       # the object-store secret key
# LAKEFS_SECRET_KEY=<generated>
# LAKEFS_ENCRYPT_SECRET=<generated>
# LBX_AUTH__SIGNING_KEY=<generated>             # signs API tokens; rotating invalidates all of them
# LBX_FORGYX__DEPLOY_SIGNING_KEY=<generated>    # signs an edge rollout manifest
# LBX_PHASE4__GOVERN__ATTESTATION_KEY=<generated>  # signs the redaction-coverage proof on a release
#
# What a browser is handed for a presigned download. Inside the compose network MinIO is `minio:9000`,
# which a browser cannot resolve, so this must be an address the browser can actually reach. Change the
# host when serving from anything other than the machine you are sitting at.
# LBX_MINIO__PUBLIC_ENDPOINT=http://localhost:9000
