.venv/
__pycache__/
*.pyc
.scratch/
.env
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
web/node_modules/
# Bare rule too: vitest resolves its cache to the nearest node_modules from the cwd, so running it from the
# repo root (rather than web/) created a root node_modules holding one results.json - which was committed
# and then re-dirtied by every test run.
node_modules/
web/.next/
*.pt
# Released checkpoints are the exception, tracked through git-lfs so the repo stays small. Everything else
# under *.pt is a local training artifact and stays out.
!models/*.pt
*.onnx
*.engine
.cloud.env
runs/
*.log
*.mcap
.DS_Store
data/
AUDIT.md
*.bin
*.pcd
!docs/screenshots/*.png
web/.design-ref/
.perception_work/
demos/

# Documentation build output and the API reference generated from the running app. Both are produced by
# `make docs` and by CI on every publish; committing them would mean a stale schema could be reviewed as
# if it were current.
/site/
/docs/api/openapi.json
/docs/api/inventory.md
/docs/guide/platforms.md
/docs/guide/editor.md
/docs/guide/shortcuts.md
